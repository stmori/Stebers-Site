# Copy to deploy/.env (never commit .env). Used by docker-compose.yml for the whole stack.
DOMAIN=:80
# DOMAIN=yourdomain.tech, www.yourdomain.tech

OPENAI_API_KEY=
MODEL=gpt-4o-mini
# OPENAI_BASE_URL=          # leave unset for OpenAI; set for any OpenAI-compatible server
MOCK_LLM=0                  # 1 = canned model output (real retrieval), no key needed

RATE_PER_MIN=6
RATE_PER_DAY=60
MAX_IMAGE_MB=8
# CORS_ORIGINS=http://localhost:3000   # only for `next dev` (web/) against the API directly
# WEB_DOCKERFILE=deploy/web-fallback.Dockerfile
