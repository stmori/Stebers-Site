# Copy to deploy/.env (never commit .env). Used by docker-compose.yml for the whole stack.
DOMAIN=:80
# DOMAIN=yourdomain.tech, www.yourdomain.tech

PROVIDER=anthropic          # anthropic (Claude) or openai
ANTHROPIC_API_KEY=          # from platform.claude.com -> API keys
MODEL=claude-haiku-5-5      # any Claude model ID, e.g. claude-sonnet-5-5 for stronger answers
EFFORT=low                  # Claude only: low | medium | high
MAX_OUTPUT_TOKENS=2048      # per model call, includes the model's thinking

# OpenAI instead: PROVIDER=openai, OPENAI_API_KEY=..., MODEL=gpt-4o-mini
OPENAI_API_KEY=
# OPENAI_BASE_URL=          # leave unset for OpenAI; set for any OpenAI-compatible server
MOCK_LLM=0                  # 1 = canned model output (real retrieval), no key needed

RATE_PER_MIN=6
RATE_PER_DAY=60
MAX_IMAGE_MB=8
# CORS_ORIGINS=http://localhost:3000   # only for `next dev` (web/) against the API directly
# WEB_DOCKERFILE=deploy/web-fallback.Dockerfile
