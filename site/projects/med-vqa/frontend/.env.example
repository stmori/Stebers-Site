# Copy to .env.local for `npm run dev` (never commit .env.local)

# 1 = fake answers in the browser, no backend needed (good for UI work)
NEXT_PUBLIC_MOCK=1

# Where the API lives. Empty = same origin (/api/...), which is what Caddy does in Docker.
# For `next dev` against a local API container: http://localhost:8000  (and set CORS_ORIGINS=http://localhost:3000 in the API's .env)
NEXT_PUBLIC_API_BASE=

# Serve under a sub-path, e.g. /projects/med-vqa when it sits inside the main site. Empty = root.
NEXT_PUBLIC_BASE_PATH=
