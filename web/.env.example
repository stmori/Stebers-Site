# Copy to .env.local for `npm run dev` (never commit .env.local)

# Med-VQA: 1 = fake answers in the browser, no backend needed (good for UI work)
NEXT_PUBLIC_MOCK=1

# Med-VQA API base. Empty = /api/med-vqa on the same origin, which is what Caddy serves in Docker.
# For `next dev` against the API container: http://localhost:8000/api  (and CORS_ORIGINS=http://localhost:3000 in deploy/.env)
NEXT_PUBLIC_MEDVQA_API=
